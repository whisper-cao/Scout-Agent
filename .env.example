# ---- Scout Agent 配置 ----
# 复制为 .env 后按需修改

# ===== 必填：凭据加密主密钥 =====
# 用于加密数据库中保存的 API Key。首次部署请生成一个随机值：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 不设置也能跑，但容器重启后已保存的 API Key 将无法解密，需要重新填写。
SCOUT_SECRET_KEY=

# 登录会话有效期（秒），默认 7 天
SCOUT_SESSION_TTL=604800

# API 配置内存缓存 TTL（秒），默认 60
SCOUT_CONFIG_CACHE_TTL=60

# ===== 默认模型标识（写入长期记忆的用户偏好）=====
SCOUT_DEFAULT_MODEL=scout-pro

# ===== 单次任务最大工具调用步数（用户可在界面覆盖）=====
SCOUT_MAX_STEPS=12
# 自主决策轮数上限（用户可在界面上按账号覆盖）
SCOUT_MAX_ROUNDS=12

# ===== 全局默认网关（可选）=====
# 每个用户也可以在界面「账号与 API」里配置自己的网关，优先级高于这里。
# 留空则 Agent 走确定性工作流，所有工具照常执行，只是没有模型推理与总结润色。
# SCOUT_LLM_BASE=http://your-gateway:8000/v1
# SCOUT_LLM_KEY=sk-xxxx
# SCOUT_LLM_MODEL=qwen

TZ=Asia/Shanghai